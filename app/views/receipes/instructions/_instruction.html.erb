<div class="nested-form-wrapper" data-new-record="<%= instruction_form.object.new_record? %>">
  <h2 class="govuk-heading-m">
    Instruction <span class="record-counter"></span>
  </h2>

  <%= instruction_form.hidden_field :id %>
  <%= instruction_form.hidden_field :step, value: instruction_form.object.step || instruction_form.index.to_i + 1 %>

  <%= instruction_form.govuk_text_area :body, label: { text: 'Description' }, rows: 5 %>

  <% unless instruction_form.index == 0 %>
    <button type="button" class="govuk-button govuk-button--secondary" data-action="nested-form#remove">Remove instruction</button>
  <% end %>

  <%= instruction_form.hidden_field :_destroy %>
</div>
