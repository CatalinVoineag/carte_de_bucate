<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-header-l"><%= @receipe.name %></h1>
  </div>

  <div class="govuk-grid-column-two-thirds">
    <% if @receipe.image.present? %> 
      <%= image_tag url_for(@receipe.image), class: "img-thumbnail" %>
    <% end %> 
  </div>

  <div class="govuk-grid-column-one-third">
    <p class="govuk-body"><strong>Prep time:</strong> <%= @receipe.prep_time %></p>
    <p class="govuk-body"><strong>Cook time:</strong> <%= @receipe.cook_time %></p>
    <p class="govuk-body"><strong>Servings:</strong> <%= @receipe.servings %></p>
    <p class="govuk-body"><strong>Tags:</strong> <%= @receipe.tags&.join(", ") %></p>

    <div id="save_receipe">
      <%= render SaveReceipeComponent.new(receipe: @receipe, user: current_user) %> 
    </div>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full govuk-!-margin-top-6">
    <p class="govuk-body"><%= @receipe.description %></p>
  </div>

  <div class="govuk-grid-column-one-third">
    <%= tag.p class: "govuk-body-l" do %> 
      <strong>Ingredients:</strong> 
    <% end %> 

    <%= govuk_list spaced: true do %>
      <% @receipe.receipe_ingredients.each do |receipe_ingredient| %>
        <%= tag.li render IngredientComponent.new(receipe_ingredient:) %>
      <% end %> 
    <% end %>
  </div>

  <div class="govuk-grid-column-two-thirds">
    <%= tag.p class: "govuk-body-l" do %> 
      <strong>Instructions:</strong> 
    <% end %> 

    <%= govuk_list type: :number, spaced: true do %>
      <% @receipe.instructions.each do |instruction| %>
        <%= tag.li instruction.body %>
      <% end %> 
    <% end %>
  </div>

  <div class="govuk-grid-column-full">
    <% if @receipe.draft? %>
      <p class="govuk-body"><strong class="govuk-tag govuk-tag--grey">Draft</strong> This receipe is not in the Receipes list yet.</p>
    <% end %>

    <%= govuk_button_link_to "Edit receipe", edit_receipe_path(@receipe), secondary: true %>
    <%= button_to "Delete receipe", receipe_path(@receipe), method: :delete, class: "govuk-button govuk-button--warning", form: { data: { turbo_confirm: "Delete this receipe? It will also be removed from everyone's My receipes. This cannot be undone." } } %>

  </div>
</div>
