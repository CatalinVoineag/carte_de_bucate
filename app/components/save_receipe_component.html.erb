<% if user.present? && receipe.published? %>
  <% if user.my_receipes.exists?(global_receipe_id: receipe.id) %>
    <%= render partial: "save_receipes/remove_receipe", locals: { receipe: } %>
  <% else %>
    <%= render partial: "save_receipes/save_receipe", locals: { receipe: } %>
  <% end %>
<% end %>
